{
  "name": "tradecopy-3",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "extension:dev": "bun run --cwd extension dev",
    "extension:dev:firefox": "bun run --cwd extension dev:firefox",
    "extension:build": "bun run --cwd extension build",
    "extension:build:firefox": "bun run --cwd extension build:firefox",
    "extension:zip": "bun run --cwd extension zip",
    "extension:zip:firefox": "bun run --cwd extension zip:firefox",
    "extension:typecheck": "bun run --cwd extension typecheck",
    "extension:test": "bun run --cwd extension test",
    "extension:test:watch": "bun run --cwd extension test:watch",
    "extension:test:coverage": "bun run --cwd extension test:coverage",
    "format": "bun fmt extension package.json bunfig.toml README.md docs",
    "format:check": "bun fmt --check extension package.json bunfig.toml README.md docs",
    "backend:test": "cd backend && uv run pytest",
    "backend:lint": "cd backend && uv run ruff check .",
    "verify": "bun run --parallel format:check extension:typecheck extension:test backend:test backend:lint",
    "backend:build-companion": "powershell -ExecutionPolicy Bypass -File backend/build-companion.ps1"
  },
  "workspaces": [
    "extension"
  ]
}
