{
  "name": "tradingview-optuna-optimiser-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "bun --bun wxt prepare",
    "dev": "bun --bun wxt",
    "dev:firefox": "bun --bun wxt -b firefox",
    "build": "bun --bun wxt build",
    "build:firefox": "bun --bun wxt build -b firefox",
    "zip": "bun --bun wxt zip",
    "zip:firefox": "bun --bun wxt zip -b firefox",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.test.json",
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch",
    "test:coverage": "bun test --isolate --coverage"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wxt": "0.21.4"
  }
}
